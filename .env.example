# Desenvolvimento local; preserve seu .env existente.
DATABASE_URL="postgresql://tcc:tcc_dev_local@127.0.0.1:5432/tcc_prototipo"
TOKEN_SECRET=troque_por_um_segredo_aleatorio_de_32_caracteres
TOKEN_EXPIRATION=1d
APP_PORT=3001
NODE_ENV=development
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Produção: origem HTTPS explícita e segredo aleatório com pelo menos 32 caracteres.
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_TIMEOUT_MS=160000
UPLOAD_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=10485760
# Caminho relativo a tcc-back, ou absoluto em volume persistente privado.
UPLOAD_DIR=uploads/policies
