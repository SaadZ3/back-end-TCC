{
  "name": "tcc-api-lgpd-maturity",
  "version": "1.0.0",
  "description": "API REST para avaliação de maturidade empresarial com base na LGPD e ISO 27701",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.cjs",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prisma:validate": "prisma validate",
    "prisma:deploy": "prisma migrate deploy",
    "db:check": "node scripts/check-db.cjs",
    "user:create": "tsx scripts/create-user.ts",
    "test:auth": "tsx --test tests/auth.integration.ts",
    "test:analyses": "tsx --test tests/analyses.integration.ts",
    "test:analyses:real": "tsx --test tests/analyses.real.integration.ts",
    "test:migration": "tsx --test tests/migration.integration.ts"
  },
  "keywords": [
    "lgpd",
    "iso-27701",
    "maturity-assessment",
    "privacy"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.4.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.17.0 <23",
    "npm": ">=10 <11"
  }
}
